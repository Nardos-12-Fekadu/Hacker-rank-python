def calculate_average(numbers):
    if not numbers:
        return 0

    return sum(numbers) / len(numbers)
scores = [80, 75, 90, 85]

average = calculate_average(scores)

print(average)




def find_maximum(numbers):
    if not numbers:
        return None

    maximum = numbers[0]

    for number in numbers[1:]:
        if number > maximum:
            maximum = number

    return maximum
