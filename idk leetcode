class Solution(object):

    def gcd(self, a, b):
        while b:
            a, b = b, a % b
        return a

    def gcdSum(self, nums):
        prefix = []

        mx = 0
        for x in nums:
            mx = max(mx, x)
            prefix.append(self.gcd(x, mx))

        prefix.sort()

        left = 0
        right = len(prefix) - 1
        ans = 0

        while left < right:
            ans += self.gcd(prefix[left], prefix[right])
            left += 1
            right -= 1

        return ans
